# Copy this file to ".env" and fill in your own values.
PORT=5000

# MySQL connection
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=hosteldesk

# Any long random string. Used to sign login tokens.
JWT_SECRET=change_this_to_a_long_random_string

# Email (optional). Leave SMTP_HOST empty and emails are just printed in the terminal.
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, and use an "App Password".
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=HostelDesk <no-reply@hosteldesk.local>
